[{"수집일자":"2026-07-20","상품번호":"A000000223414","리뷰ID":"63039348","작성일":"2026.07.20","별점":"5","체험단여부":"0","리뷰타입":"NORMAL","옵션":"마데카소사이드 흔적리페어 1매","피부타입":"A01","피부톤":"B02","피부고민":"C01,C05","도움수":"1","유용점수":"1800.0","포토여부":"1","재구매":"1","닉네임":"몽캔디","리뷰본문":"⏰\r\n이러나 저러나 마음의 고향과 같은 메디힐의 에센셜 마스크팩\r\n마데카소사이드 흔적 리페어랍니다\r\n\r\n최근에는 장시간 붙여두는 겔마스크에 빠져있었는데,\r\n갑작스러운 피부염이 올라와서 중단하게 되었거든요\r\n뭔가 피부위를 장시간 덮어두는 게 자극적일 거라 판단해서\r\n그 시기에는 겔마스크보다 일반 시트팩을 급하게 구매해서\r\n붙여주며 진정에 힘썼던 것 같아요\r\n\r\n흐르지 않도록 적당히 에센스가 머금어져 있는 시트와,\r\n부드럽지만 컨트롤 하기에 어렵지 않은 두께감\r\n제품을 떼어낸 뒤에는 남은 에센스를 흡수 시켜주며 추가로\r\n세럼이나 크림을 더하지 않아도 되는 요즘입니다"},{"수집일자":"2026-07-20","상품번호":"A000000223414","리뷰ID":"63058462","작성일":"2026.07.20","별점":"5","체험단여부":"0","리뷰타입":"NORMAL","옵션":"PDRN 모공결광 10+1매","피부타입":"A06","피부톤":"B01","피부고민":"C09","도움수":"0","유용점수":"1800.0","포토여부":"1","재구매":"0","닉네임":"졸음쉼터","리뷰본문":"에센스가 듬뿍 들어있는 마스크팩이라 피부에 촉촉하게 사용할 수 있어서 좋았어요! 😊\r\n가격도 부담스럽지 않아서 매일 꾸준히 사용하기 좋고, 1일 1팩용으로 딱인 제품이에요.\r\n팩을 하고 나면 피부가 촉촉하고 탱탱해지는 느낌이 들고, 꾸준히 사용했을 때 피부 컨디션이 좋아지는 게 느껴져서 만족스러웠어요 ✨\r\n가성비도 좋고 효과도 좋아서 데일리 마스크팩으로 추천하고 싶은 제품이에요!"},{"수집일자":"2026-07-20","상품번호":"A000000223414","리뷰ID":"63057673","작성일":"2026.07.20","별점":"5","체험단여부":"0","리뷰타입":"NORMAL","옵션":"마데카소사이드 흔적리페어 1매","피부타입":"A03","피부톤":"B03","피부고민":"C01,C08","도움수":"0","유용점수":"1800.0","포토여부":"1","재구매":"0","닉네임":"G0D","리뷰본문":"🎀피부타입: 수부지/민감피부/봄브라이트/겨울비비드\r\n\r\n🎀솔직후기\r\n오랜만에 구매해봤어요 이번에 부산 여행 가게돼서 날도 덥고 오랜만에 구매해서 가져갔는데 역시나 좋더라고요\r\n밀착력이 좋아서 붙이기도 편하고 에센스 양도 많아서 촉촉해요 무엇보다도 진정효과가 뛰어나서 요즘같은 더운 날에 진정시키기 좋더라고요\r\n가격도 저렴해서 자주 사용하기 너무 좋아요 자극도 없어서 민감성 피부도 사용하기 좋을거 같아요\r\n사용 후에는 크림으로 마무리 했어요 지성 피부는 추후 단계가 필요 없을거 같긴한데 건성 피부나 수부지 피부는 추후 단계가 조금 필요할거 같긴해요 산뜻한 마무리감 입니다"},{"수집일자":"2026-07-20","상품번호":"A000000223414","리뷰ID":"63002636","작성일":"2026.07.19","별점":"5","체험단여부":"0","리뷰타입":"NORMAL","옵션":"히알루론산 고밀도 수분 4매","피부타입":"A06","피부톤":"B02","피부고민":"C01,C05","도움수":"2","유용점수":"2952.0","포토여부":"1","재구매":"1","닉네임":"동동동대문","리뷰본문":"예민한 피부인데 자극없고 순해서 좋아요! 시트도 부드러운 편이에요"},{"수집일자":"2026-07-20","상품번호":"A000000223414","리뷰ID":"6300